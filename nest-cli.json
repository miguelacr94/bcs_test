{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/api-gateway",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "applications": {
      "type": "application",
      "root": "apps/applications",
      "entryFile": "main",
      "sourceRoot": "apps/applications/src",
      "compilerOptions": {
        "tsConfigPath": "apps/applications/tsconfig.app.json"
      }
    },
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json"
      }
    },
    "customer": {
      "type": "application",
      "root": "apps/customer",
      "entryFile": "main",
      "sourceRoot": "apps/customer/src",
      "compilerOptions": {
        "tsConfigPath": "apps/customer/tsconfig.app.json"
      }
    },
    "technical-test": {
      "type": "application",
      "root": "apps/technical-test",
      "entryFile": "main",
      "sourceRoot": "apps/technical-test/src",
      "compilerOptions": {
        "tsConfigPath": "apps/technical-test/tsconfig.app.json"
      }
    },
    "user-core": {
      "type": "application",
      "root": "apps/user-core",
      "entryFile": "main",
      "sourceRoot": "apps/user-core/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user-core/tsconfig.app.json"
      }
    }
  }
}